---
/**
 * Footer.astro
 * The site footer: the site name and the contact links.
 * Hidden when a page is printed.
 */
import { site } from "@config";
import ContactRow from "./ContactRow.astro";
---

<footer class="footer" data-print="hide">
  <div class="container inner">
    <p class="name">{site.name}</p>
    <ContactRow />
  </div>
</footer>

<style>
  .footer {
    margin-block-start: var(--space-16);
    border-block-start: var(--border-width) solid var(--color-line);
    font-size: var(--text-sm);
  }

  .inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding-block: var(--space-8);
  }

  .name {
    font-weight: var(--weight-bold);
  }
</style>
