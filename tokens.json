{
  "$description": "Single source of design tokens (W3C Design Tokens format). `base` is the neutral placeholder theme and the full set. Any other top-level group (e.g. `will`) is a theme that lists ONLY the values it overrides. Run `npm run tokens` to regenerate src/styles/tokens.css. Nothing here is a design decision yet: base values are deliberately plain.",
  "base": {
    "color": {
      "bg": { "$type": "color", "$value": "#ffffff" },
      "surface": { "$type": "color", "$value": "#f4f4f4" },
      "ink": { "$type": "color", "$value": "#111111" },
      "ink-muted": { "$type": "color", "$value": "#5c5c5c" },
      "line": { "$type": "color", "$value": "#d9d9d9" },
      "accent": { "$type": "color", "$value": "#111111" },
      "placeholder": { "$type": "color", "$value": "#b00020" }
    },
    "font": {
      "display": { "$type": "fontFamily", "$value": "system-ui, sans-serif" },
      "body": { "$type": "fontFamily", "$value": "system-ui, sans-serif" },
      "mono": { "$type": "fontFamily", "$value": "ui-monospace, monospace" }
    },
    "weight": {
      "regular": { "$type": "fontWeight", "$value": 400 },
      "medium": { "$type": "fontWeight", "$value": 500 },
      "bold": { "$type": "fontWeight", "$value": 700 }
    },
    "text": {
      "xs": { "$type": "dimension", "$value": "0.75rem" },
      "sm": { "$type": "dimension", "$value": "0.875rem" },
      "md": { "$type": "dimension", "$value": "1rem" },
      "lg": { "$type": "dimension", "$value": "1.25rem" },
      "xl": { "$type": "dimension", "$value": "1.5rem" },
      "2xl": { "$type": "dimension", "$value": "2rem" },
      "3xl": { "$type": "dimension", "$value": "3rem" }
    },
    "leading": {
      "tight": { "$type": "number", "$value": 1.15 },
      "normal": { "$type": "number", "$value": 1.5 }
    },
    "space": {
      "1": { "$type": "dimension", "$value": "0.25rem" },
      "2": { "$type": "dimension", "$value": "0.5rem" },
      "3": { "$type": "dimension", "$value": "0.75rem" },
      "4": { "$type": "dimension", "$value": "1rem" },
      "6": { "$type": "dimension", "$value": "1.5rem" },
      "8": { "$type": "dimension", "$value": "2rem" },
      "12": { "$type": "dimension", "$value": "3rem" },
      "16": { "$type": "dimension", "$value": "4rem" },
      "24": { "$type": "dimension", "$value": "6rem" }
    },
    "radius": {
      "none": { "$type": "dimension", "$value": "0" },
      "sm": { "$type": "dimension", "$value": "2px" },
      "md": { "$type": "dimension", "$value": "6px" }
    },
    "border": {
      "width": { "$type": "dimension", "$value": "1px" }
    },
    "grid": {
      "columns": { "$type": "number", "$value": 12 },
      "gutter": { "$type": "dimension", "$value": "1.5rem" },
      "margin": { "$type": "dimension", "$value": "1.5rem" },
      "max": { "$type": "dimension", "$value": "72rem" },
      "measure": { "$type": "dimension", "$value": "40rem" }
    },
    "motion": {
      "duration": { "$type": "duration", "$value": "0ms" },
      "ease": { "$type": "cubicBezier", "$value": "ease" }
    }
  },
  "will": {
    "$description": "Will's theme. Empty until the art direction is chosen in phase 2. Add only the tokens that differ from base."
  }
}
